  "overlays": {
    "OV:web": {
      "tests": [
        "small supported viewport",
        "text zoom 200%",
        "keyboard focus and obscured focus",
        "browser back/reload if requested"
      ],
      "note": "Do not claim universal responsive/accessibility conformance from one viewport"
    },
    "OV:touch": {
      "tests": [
        "actual supported touch target bounds and spacing",
        "no hover-only essential information",
        "gesture alternative where applicable"
      ],
      "note": "Measure actual units; proposed 44px is not a blanket standard"
    },
    "OV:controller": {
      "tests": [
        "focus graph and reveal",
        "selection versus commit",
        "cancel/back mapping"
      ],
      "note": "Do not invent controller support when input is untested"
    },
    "OV:keyboard": {
      "tests": [
        "tab/arrow route as appropriate",
        "visible focus",
        "confirm/cancel actual binding"
      ],
      "note": "Preserve host/product bindings; example Enter/Esc is not universal"
    },
    "OV:localization": {
      "tests": [
        "real long labels",
        "locale-specific line breaks and number formats",
        "zoom with text reflow"
      ],
      "note": "Do not infer original product CSS from scaled research images"
    }
  },
  "reference_loading_policy": {
    "strategy": "one_routed_file_first",
    "branch_references_are_isolated": true,
    "load_sibling_recipes": false,
    "unsupported_loads_domain_recipe": false,
    "sources": "resolve selected IDs only; prior metadata does not prove a new inspection"
  }
